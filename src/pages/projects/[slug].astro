---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="prose">
    <p class="page-kicker">Project</p>
    <h1>{project.data.title}</h1>
    <p class="links">
      <a href={project.data.github} rel="noopener noreferrer">GitHub</a>
      {
        project.data.demo && (
          <a href={project.data.demo} rel="noopener noreferrer">
            Live demo
          </a>
        )
      }
    </p>
    <ul class="tags">
      {project.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <Content />
  </article>
</BaseLayout>
