---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/content";

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="Notes and longer-form writing.">
  <p class="page-kicker">Journal</p>
  <h1>Blog</h1>
  {
    posts.length > 0 ? (
      <>
        <p class="lede">
          Notes on private cloud, security automation, and applied AI. The feed is
          at <a href="/rss.xml">/rss.xml</a>.
        </p>
        <div class="grid grid-2 section">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </>
    ) : (
      <p class="lede">
        No posts yet. Longer pieces live under <a href="/writing">Writing</a>. The
        RSS feed is <a href="/rss.xml">/rss.xml</a>.
      </p>
    )
  }
</BaseLayout>
