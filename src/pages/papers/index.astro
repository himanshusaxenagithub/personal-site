---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperCard from "../../components/PaperCard.astro";
import { getPapers } from "../../lib/content";

const papers = await getPapers();
---

<BaseLayout
  title="Earlier publications"
  description="B.Tech-era Production and Industrial Engineering publications from Delhi Technological University (2014)."
>
  <p class="page-kicker">Archive</p>
  <h1>Earlier publications</h1>
  <p class="lede">
    These papers are from undergraduate research in Production and Industrial
    Engineering at Delhi Technological University, around 2014. They are earlier
    work, distinct from current work in security compliance, private cloud, and
    applied AI.
  </p>
  <section class="section" aria-labelledby="btech-papers-heading">
    <h2 id="btech-papers-heading">Production and Industrial Engineering (B.Tech, 2014)</h2>
    <div class="grid">
      {papers.map((paper) => <PaperCard paper={paper} headingLevel="h3" />)}
    </div>
  </section>
</BaseLayout>
