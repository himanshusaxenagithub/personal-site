---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperCard from "../../components/PaperCard.astro";
import { getPapers } from "../../lib/content";

const papers = await getPapers();
---

<BaseLayout
  title="Papers"
  description="Peer-reviewed and conference publications."
>
  <p class="page-kicker">Research</p>
  <h1>Papers</h1>
  <p class="lede">
    Earlier publications on bearing condition monitoring and energy harvesting.
  </p>
  <div class="grid section">
    {papers.map((paper) => <PaperCard paper={paper} headingLevel="h2" />)}
  </div>
</BaseLayout>
