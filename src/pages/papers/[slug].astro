---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatAuthors, getPapers } from "../../lib/content";

export async function getStaticPaths() {
  const papers = await getPapers();
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
const links = [
  paper.data.pdf ? { href: paper.data.pdf, label: "Download PDF" } : null,
  paper.data.doi ? { href: paper.data.doi, label: "DOI" } : null,
  paper.data.arxiv ? { href: paper.data.arxiv, label: "arXiv" } : null,
  paper.data.scholar ? { href: paper.data.scholar, label: "Google Scholar" } : null,
  paper.data.url ? { href: paper.data.url, label: "Publisher" } : null,
].filter((link): link is { href: string; label: string } => link !== null);
---

<BaseLayout title={paper.data.title} description={paper.data.abstract}>
  <article class="prose">
    <p class="page-kicker">
      B.Tech-era publication · Production and Industrial Engineering · {paper.data.year}
    </p>
    <p class="meta">{paper.data.venue}</p>
    <h1>{paper.data.title}</h1>
    <p class="meta">{formatAuthors(paper.data.authors)}</p>
    {
      links.length > 0 && (
        <p class="links">
          {links.map((link) => (
            <a href={link.href} rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </p>
      )
    }
    <h2>Abstract</h2>
    <p>{paper.data.abstract}</p>
    <Content />
  </article>
</BaseLayout>
